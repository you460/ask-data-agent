# ============ 大模型配置（DeepSeek，兼容任意 OpenAI 协议服务）============
DEEPSEEK_API_KEY=在这里填入你的APIKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=3
AGENT_MAX_ROUNDS=12
# 检索模式：legacy（模型按需调用 search_table）或 prefetch（先检索再拼上下文）
SCHEMA_RETRIEVAL_MODE=legacy

# ============ 数据库配置（PostgreSQL）============
DB_HOST=localhost
DB_PORT=5432
DB_NAME=askdata_demo
DB_USER=postgres
DB_PASSWORD=在这里填入你的数据库密码

# ============ 查询资源限制 ============
SQL_STATEMENT_TIMEOUT_MS=10000
SQL_MAX_RESULT_ROWS=5000
# 同一条 SQL 连续执行失败多少次后放弃
SQL_MAX_EXEC_ERRORS=3

# ============ 评测复现标识 ============
EVALUATION_DATA_SNAPSHOT=customer_marketing_2026Q1_20260331
EVALUATION_PROMPT_VERSION=main.SYSTEM_PROMPT.v9
EVALUATION_VERIFY_SNAPSHOT=1
